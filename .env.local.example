# Local dev/demo: SQLite, offline-safe. Leave this set for `next dev`.
USE_SQLITE=true
SQLITE_PATH=./caretaker.db

# Vercel deployment: Neon Postgres. Provisioned via `vercel integration add neon`;
# `vercel env pull` fills this in for real. Unset USE_SQLITE (or omit it) to use
# this locally instead — e.g. to test against the same DB as the deployment.
DATABASE_URL=

# LLM translation (lib/llm/client.ts) — pick one, set matching key
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Vapi (all TTS playback + relay voice mode + /popo/call companion)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Apify daily news scrape
APIFY_TOKEN=
